# ============================================================================
# ALERT SYSTEM CONFIGURATION
# ============================================================================


# ==============================
# --- Database Configuration ---
# ==============================
# (Handled by db_utils)


# SSH Tunnel into ubuntu
USE_SSH_TUNNEL=True
SSH_HOST=XX.XXX.XXX.XXX
SSH_PORT=22
SSH_USER=username
SSH_KEY_PATH=/app/ssh_ubuntu_key
#SSH_KEY_PATH=/Users/prominence/.ssh/datalab_prominence_prod.pem

# Database
DB_HOST=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DB_PORT=5432
DB_NAME=database_name
DB_USER=user_name
DB_PASS=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ================================
# --- SMTP Email Configuration ---
# ================================

SMTP_HOST=XX.XXX.XXX.XX
SMTP_PORT=25
SMTP_USER=user@email.com
SMTP_PASS=XXXXXXXXXXXXXXXXXXXXXXXXX


# ============================================================================
# RUNTIME MODE CONFIGURATION
# ============================================================================
# DRY_RUN=True: email only sent to DRY_RUN_EMAIL (if set), otherwise no emails at all
# DRY_RUN_EMAIL: Redirect all emails to this address in dry-run mode (leave empty for no emails)
# dp.skliros@gmail.com,master.prominencetest@gtmailplus.com,data@prominencemaritime.com
# RUN_ONCE=True: run once and exit, False = run continuously on schedule
# ============================================================================

DRY_RUN=True
DRY_RUN_EMAIL=dry_run@email.com
RUN_ONCE=False


# ========================
# --- Email Recipients ---
# ========================
# Internal recipients (always get notifications)
INTERNAL_RECIPIENTS=cc_email_addresses

# Company-specific TO recipients (applied based on vessel email domain)
PROMINENCE_EMAIL_TO_RECIPIENTS=
SEATRADERS_EMAIL_TO_RECIPIENTS=

# Company-specific CC recipients (applied based on vessel email domain)
PROMINENCE_EMAIL_CC_RECIPIENTS=
SEATRADERS_EMAIL_CC_RECIPIENTS=


# =====================
# --- Feature Flags ---
# =====================
ENABLE_EMAIL_ALERTS=True
ENABLE_TEAMS_ALERTS=False
ENABLE_SPECIAL_TEAMS_EMAIL_ALERT=False
SPECIAL_TEAMS_EMAIL=


# ========================
# --- Company Branding ---
# ========================
PROMINENCE_LOGO=trans_logo_prominence_procreate_small.png
SEATRADERS_LOGO=
#trans_logo_seatraders_procreate_small.png


# ============================================================================
# Document Links configuration
# ============================================================================

# Make column names clickable links (to event_id) 
ENABLE_LINKS=True
BASE_URL=https://base.url
# URL path pattern (without the ID), will append /{invoice_no} (or whatever the correct extension is) automatically
URL_PATH=/path

# ==================
# --- Scheduling ---
# ==================
SCHEDULE_FREQUENCY_HOURS=
SCHEDULE_TIMES=11:00
#12:00,18:00
SCHEDULE_DAYS=2
#isoweekday: 1=Monday, 2=Tuesday, ..., 7=Sunday
SCHEDULE_TIMES_TIMEZONE=Europe/Athens
TIMEZONE=UTC


# ============================
# --- Tracking & Reminders ---
# ============================
REMINDER_FREQUENCY_DAYS=
SENT_EVENTS_FILE=sent_alerts.json
RESEND_EVENTS_ON=True

# =======================
# --- SQL Query Files ---
# =======================
# (Alert-specific - defined in each alert class)
SQL_QUERY_FILE=ApprovedCasesNoPO.sql

# Alert-Specific Configuration (check last 24 hours)
LOOKBACK_DAYS=730
INCLUDE_GREY_METADATA_SECTION=True


# ===============
# --- Logging ---
# ===============
LOG_FILE=alerts.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5


# ----------------------------------
# --------- User permissions -------
# ----------------------------------
# echo UID=$(id -u) and echo GID=$(id -g)
UID=502
GID=502
